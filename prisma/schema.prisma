// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Notification {
  id String @id @default(uuid())

  senderId   String @map("sender_id")
  receiverId String @map("receiver_id")

  channel             String  @map("channel")
  notificationPayload Json    @map("notification_payload")
  notificationType    String  @map("notification_type")
  isRead              Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model PushDevice {
  // Random UUID generated by the mobile app and persisted per installation.
  deviceId  String   @id @map("device_id") @db.Uuid
  userId    String   @map("user_id") @db.VarChar(128)
  token     String   @unique @db.VarChar(4096)
  platform  String   @db.VarChar(7)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("push_devices")
}

model MessagePushJob {
  messageId          String    @id @map("message_id")
  guildId            String    @map("guild_id")
  channelId          String    @map("channel_id")
  senderId           String    @map("sender_id")
  senderName         String    @map("sender_name")
  channelName        String    @map("channel_name")
  body               String
  expiresAt          DateTime  @map("expires_at")
  processedDeviceIds String[]  @default([]) @map("processed_device_ids")
  attempts           Int       @default(0)
  nextAttemptAt      DateTime  @default(now()) @map("next_attempt_at")
  leaseId            String?   @map("lease_id")
  completedAt        DateTime? @map("completed_at")
  lastError          String?   @map("last_error")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([completedAt, nextAttemptAt])
  @@index([expiresAt])
  @@map("message_push_jobs")
}
